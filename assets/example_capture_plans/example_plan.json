{
  "schema_version": 1,
  "name": "example_plan",
  "tether": "Tether1",
  "device": {
    "type": "tether",
    "tether_length_m": 20.0
  },
  "phases": [
    {
      "id": "rendezvous",
      "max_velocity_mps": 25.0,
      "max_force_n": 25.0,
      "transitions": [
        {
          "to": "approach",
          "all_of": {
            "distance_m": {
              "less_than": 2000.0
            }
          }
        }
      ]
    },
    {
      "id": "approach",
      "max_velocity_mps": 2.0,
      "max_force_n": 3.0,
      "transitions": [
        {
          "to": "terminal",
          "all_of": {
            "distance_m": {
              "less_than": 50.0
            }
          }
        }
      ]
    },
    {
      "id": "terminal",
      "max_velocity_mps": 0.5,
      "max_force_n": 2.0,
      "shrink_rate_mps": 0.01,
      "transitions": [
        {
          "to": "capture",
          "all_of": {
            "distance_m": {
              "less_than": 5.0
            }
          }
        },
        {
          "to": "approach",
          "all_of": {
            "distance_m": {
              "greater_than": 50.0
            }
          }
        }
      ]
    },
    {
      "id": "capture",
      "max_velocity_mps": 0.5,
      "max_force_n": 2.0,
      "shrink_rate_mps": 0.005,
      "end": "success"
    }
  ]
}